{
  "name": "@trader-sim/api",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/with-env.mjs prisma migrate deploy",
    "db:migrate:dev": "node scripts/with-env.mjs prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:embedded": "node scripts/dev-db.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "~6.19.0",
    "@trader-sim/engine": "2.0.0",
    "@trader-sim/shared": "2.0.0",
    "argon2": "^0.45.1",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "nodemailer": "^7.0.9",
    "prisma": "~6.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.2",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "18.3.0-beta.17",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6"
  }
}
