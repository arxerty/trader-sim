  "onboarding": {
    "dialogTitle": "How to play",
    "stepOf": "Step {{current}} of {{total}}",
    "start": "Start trading",
    "steps": {
      "welcome": {
        "title": "Welcome to TradeSim!",
        "body": "You get $10,000 of virtual capital and 8 fictional assets. Prices move randomly, news shakes the market. Your goal is to grow your capital without going bankrupt."
      },
      "chart": {
        "title": "Read the market",
        "body": "Pick an asset in the list on the left — its candlestick chart appears in the centre. Green candles mean the price rose, red ones mean it fell. Watch the news feed: it moves prices."
      },
      "order": {
        "title": "Open a trade",
        "body": "Choose Long if you expect growth or Short if you expect a fall. Set the margin, leverage and, ideally, Stop-Loss and Take-Profit. Hotkeys: B — buy, S — sell, Space — pause."
      },
      "risk": {
        "title": "Manage risk",
        "body": "Leverage multiplies both profit and loss. If a position loses almost all of its margin it is liquidated. Each trade costs a 0.1% fee. Use Stop-Loss — it is your best friend."
      }
    }
  },
