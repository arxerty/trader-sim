# Copy to `.env` and adjust. Never commit real secrets.

# --- runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- database (docker compose service "postgres")
POSTGRES_USER=tradesim
POSTGRES_PASSWORD=tradesim
POSTGRES_DB=tradesim
DATABASE_URL=postgresql://tradesim:tradesim@localhost:5432/tradesim

# Test database for `npm test` (docker compose --profile test up -d postgres-test).
# Leave empty to let the API tests start an embedded PostgreSQL automatically.
TEST_DATABASE_URL=

# --- optional Redis cache for leaderboards (docker compose --profile redis up -d redis)
LEADERBOARD_CACHE=none
REDIS_URL=redis://localhost:6379

# --- secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
DAILY_SEED_SECRET=change-me-daily-seed-secret
# Moderation endpoints (/admin/*) are disabled when empty
ADMIN_TOKEN=

# --- URLs & cookies
WEB_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5173/api
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Path prefix under which the browser reaches the API (vite proxy / nginx: /api)
COOKIE_PATH_PREFIX=/api
# true in production behind HTTPS; defaults to NODE_ENV=production
COOKIE_SECURE=false

# --- rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_RUNS_PER_MINUTE=60

# --- e-mail: empty SMTP_HOST → mails are printed to the API log; Mailpit UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TradeSim <no-reply@tradesim.local>

# --- optional OAuth (enabled when both id and secret are set)
# Callback URLs: ${API_PUBLIC_URL}/auth/oauth/google/callback and .../github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SWAGGER_ENABLED=true
